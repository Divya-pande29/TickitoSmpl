<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==========================================
         Tikito Outlined TextInputLayout Style
         ========================================== -->
    <style name="TikitoTextInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxBackgroundMode">outline</item>
        <item name="boxStrokeColor">@color/yellow</item>
        <item name="hintTextColor">@color/lightGray</item>

    </style>


    <!-- ==========================================
         Tikito Material Button Style
         ========================================== -->
    <style name="TikitoButton"
        parent="Widget.Material3.Button">

        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/yellow</item>
        <item name="cornerRadius">12dp</item>

    </style>


    <!-- ==========================================
         Main Screen Heading
         ========================================== -->
    <style name="HeadingText">

        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>

    </style>


    <!-- ==========================================
         Subtitle Text
         ========================================== -->
    <style name="SubHeadingText">

        <item name="android:textColor">@color/lightGray</item>
        <item name="android:textSize">16sp</item>

    </style>


    <!-- ==========================================
         Clickable Yellow Text
         ========================================== -->
    <style name="LinkText">

        <item name="android:textColor">@color/yellow</item>
        <item name="android:textStyle">bold</item>

    </style>

    <!-- ==========================================
     Profile Menu Card
     ========================================== -->

    <style name="ProfileMenuCard">

        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">6dp</item>

    </style>

</resources>